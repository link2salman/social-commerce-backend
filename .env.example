# ─────────────────────────────────────────────────────────────────────────────
# Social Commerce Backend — environment template.
# Copy to .env.development / .env.staging / .env.production and fill in.
# Env is loaded per-environment by dotenv-cli in the npm scripts (see package.json)
# — there is NO dotenv.config() in the app, the script is the single source.
#
# Only the Database and JWT blocks are REQUIRED. Every integration below is
# wired end-to-end and env-gated: an EMPTY value means that feature is disabled
# (a clear 503 or a no-op), never a crash. Leave a key empty rather than filling
# it with a dummy value — a non-empty placeholder turns a clean "not configured"
# 503 into a live client that fails with a provider auth error at request time.
# INTEGRATIONS.md is the matching "what to obtain and where" checklist.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5100

# The mobile client's API_URL ends in /v1 (see the app's .env). Routes mount there.
API_PREFIX=/v1

# ── Database ────────────────────────────────────────────────────────────────
# TWO ways to connect; the app (src/config/db.ts) prefers a URL when present.
#
# 1) Local / self-hosted Postgres — discrete vars (dev default, trust auth):
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=social_commerce_dev
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# CA bundle for verified TLS. REQUIRED IN PRODUCTION — the app fails to boot in
# prod without it (an unverified TLS link is a MITM exposure), unless you set
# DB_SSL_ALLOW_UNVERIFIED=true below to deliberately accept the risk.
# DB_SSL_CA_PATH=/etc/ssl/certs/db-ca.pem
# Escape hatch: connect in prod without cert verification. Leave blank/false.
DB_SSL_ALLOW_UNVERIFIED=

# 2) Supabase-hosted Postgres — set the SESSION-mode pooler URL (port 5432)
#    from Supabase → Settings → Database → Connection string. Session mode
#    speaks the full wire protocol Sequelize needs (advisory locks, prepared
#    statements in txns, LISTEN/NOTIFY). When set, this WINS over the DB_* vars.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#    Migrations (sequelize-cli, config.cjs) should use the DIRECT connection
#    (port 5432, host db.<ref>.supabase.co) — the transaction pooler (6543)
#    breaks DDL that relies on session state. Falls back to DATABASE_URL if unset.
# SUPABASE_DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
#
#    Supabase always serves TLS. Point this at the downloaded project CA to
#    enable hostname verification. In production this is REQUIRED (boot fails
#    without it or the explicit DB_SSL_ALLOW_UNVERIFIED opt-out above); in dev we
#    skip verification.
# DB_SSL_CA_PATH=/path/to/prod-ca-2021.crt
# Surfaces the process in pg_stat_activity for triage.
DB_APP_NAME=social-commerce-api
# Pooler-aware max pool size. Keep (replicas * DB_POOL_MAX) below the Supabase
# project's pool_size or migrations/cron/sockets starve. Default 10.
DB_POOL_MAX=10

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# 32+ random bytes (`openssl rand -base64 48`). Rotating this invalidates every
# live access token. In PRODUCTION the app refuses to boot if this is under 32
# chars or looks like a placeholder — so this template value must be replaced.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Commerce / pricing ──────────────────────────────────────────────────────
# Server-authoritative cart pricing. Defaults match the app's mock byte-for-byte
# (8% tax, flat $6.99 shipping over any non-empty cart). These are flat rates —
# real address-based sales tax is a separate integration (see DEFERRED-DECISIONS).
TAX_RATE=0.08
SHIPPING_FLAT_CENTS=699

# ── Feed ranking (For You) ──────────────────────────────────────────────────
# Heuristic ranker weights (rankingService). All optional — sensible defaults
# shown. score = engagement · recency · affinity.
# RANK_W_LIKE=1
# RANK_W_COMMENT=2
# RANK_W_SHARE=3
# RANK_W_SAVE=2
# RANK_HALF_LIFE_HOURS=24     # recency half-life
# RANK_FOLLOW_BOOST=1.5       # multiplier for followed authors
# RANK_SEEN_PENALTY=0.1       # multiplier for already-engaged videos
# RANK_WINDOW_DAYS=30         # candidate freshness window
# RANK_CANDIDATE_POOL=500     # max candidates scored per request

# ── Realtime / CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed browser origins (Socket.io + Express CORS). The native
# app sends no Origin header, so it is always allowed regardless of this list.
FRONTEND_URLS=http://localhost:3000
# Optional: enables the Socket.io Redis adapter + Redis-backed rate limiting for
# horizontal scaling. Omit for single-instance dev (in-memory fallback).
# REDIS_URL=redis://localhost:6379

# ── Media / Storage (Supabase Storage) ───────────────────────────────────────
# Uploads (videos, avatars, product/chat images) go to a Supabase Storage bucket
# via signed URLs. Uses the SAME Supabase project as the DB.
# Where: Supabase → Settings → API.
#   SUPABASE_URL              → "Project URL"      (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY → "service_role" key (SERVER-ONLY — never ship it
#                                to the app; it bypasses row-level security)
# Empty → video publishing, avatar upload and chat image attachments 503.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket that holds uploads (auto-created public on first use). Default 'media'.
SUPABASE_STORAGE_BUCKET=media

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Physical goods + in-person tickets → Stripe is the compliant processor (IAP is
# prohibited for these by both stores).
# Where: Stripe Dashboard → Developers → API keys.
#   STRIPE_SECRET_KEY      → "Secret key"      (sk_test_… in dev)
#   STRIPE_PUBLISHABLE_KEY → "Publishable key" (pk_test_…) — returned to the app
#                             for its PaymentSheet; the app needs no Stripe env.
#   STRIPE_WEBHOOK_SECRET  → Developers → Webhooks → endpoint on
#                             POST /v1/webhooks/stripe (events: payment_intent.*)
#                             → "Signing secret" (whsec_…). Optional in dev: the
#                             confirm call verifies the PaymentIntent directly.
# Empty STRIPE_SECRET_KEY → every payment path returns 503.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
# Where: Firebase Console → Project settings → Service accounts → "Generate new
# private key", then base64 the whole JSON into ONE env value (no file on disk):
#   base64 -i service-account.json     (macOS)   →  paste the output here
#   base64 -w0 service-account.json    (Linux)
# The app also needs android/app/google-services.json at build time (INTEGRATIONS.md §5).
# Empty → push sending is a silent no-op (the app still runs).
FCM_SERVICE_ACCOUNT_BASE64=

# ── Email (password reset codes) ─────────────────────────────────────────────
# SMTP transport for the forgot/reset-password flow.
# Where: any SMTP provider — SendGrid, Resend, SES, Mailgun, Postmark (host,
# user and password come from their dashboard; SMTP_USER is often a literal
# such as "apikey").
# Empty SMTP_HOST → codes are generated but not delivered (the endpoints still
# succeed and never reveal account existence).
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; STARTTLS on 587 stays false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Social Commerce <no-reply@yourapp.com>

# ── Geocoding (event venues → map pins) ──────────────────────────────────────
# Server-side geocoding of event addresses into lat/lng.
# Where: Google Cloud Console → APIs & Services → Credentials → API key, with
# the GEOCODING API enabled (the app's map key needs Maps SDK for Android; one
# key can serve both). Empty → created events store null coordinates and the app
# falls back to a deep link into the maps app.
GOOGLE_MAPS_API_KEY=

# ── WebRTC calls (STUN / TURN) ───────────────────────────────────────────────
# GET /v1/calls/ice-servers returns these to the app's RTCPeerConnection. STUN
# defaults to Google's public server and needs no account; a TURN relay is what
# makes calls connect across strict/symmetric NATs and carrier networks.
# Where: Twilio (Network Traversal Service), Metered, Cloudflare Calls, or a
# self-hosted coturn. TURN_URLS accepts a comma-separated list, e.g.
# turn:turn.example.com:3478,turns:turn.example.com:5349
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Misc ────────────────────────────────────────────────────────────────────
# Legacy: not read anywhere in src/ — Supabase Storage returns public URLs
# directly. Kept only so existing deploys don't fail a config diff.
CDN_URL=https://cdn.yourapp.com
LOG_LEVEL=debug
