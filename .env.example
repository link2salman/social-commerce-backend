# ─────────────────────────────────────────────────────────────────────────────
# Social Commerce Backend — environment template.
# Copy to .env.development / .env.staging / .env.production and fill in.
# Env is loaded per-environment by dotenv-cli in the npm scripts (see package.json)
# — there is NO dotenv.config() in the app, the script is the single source.
#
# Only the Database and JWT blocks are REQUIRED. Every integration below is
# wired end-to-end and env-gated: an EMPTY value means that feature is disabled
# (a clear 503 or a no-op), never a crash. Leave a key empty rather than filling
# it with a dummy value — a non-empty placeholder turns a clean "not configured"
# 503 into a live client that fails with a provider auth error at request time.
# INTEGRATIONS.md is the matching "what to obtain and where" checklist.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5100
# Interface to bind. Blank/unset means every interface, which is what dev wants
# (the Android emulator reaches the host via 10.0.2.2, a real phone via the LAN
# IP). Behind a reverse proxy set HOST=127.0.0.1 so nginx is the only way in —
# see deploy/README.md.
HOST=

# The mobile client's API_URL ends in /v1 (see the app's .env). Routes mount there.
API_PREFIX=/v1

# ── Database (PostgreSQL 14+) ───────────────────────────────────────────────
# TWO ways to connect; the app (src/config/db.ts) prefers a URL when present.
#
# 1) Discrete vars — the local dev default. `npm run db:up` starts the
#    docker-compose Postgres these values point at (see docker-compose.yml).
#    Host port is 5433 so it can't collide with a locally installed Postgres.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=social_commerce_dev
DB_USER=iovibe
DB_PASSWORD=iovibe
DB_SSL=false
# CA bundle for verified TLS. REQUIRED IN PRODUCTION — the app fails to boot in
# prod without it (an unverified TLS link is a MITM exposure), unless you set
# DB_SSL_ALLOW_UNVERIFIED=true below to deliberately accept the risk.
# DB_SSL_CA_PATH=/etc/ssl/certs/db-ca.pem
# Escape hatch: connect in prod without cert verification. Leave blank/false.
DB_SSL_ALLOW_UNVERIFIED=

# 2) A full Postgres URL — any managed or self-hosted server (RDS/Aurora, Cloud
#    SQL, your own box). When set, this WINS over the DB_* vars above.
#    If a connection pooler sits in front, use its SESSION-mode port: session
#    mode speaks the full wire protocol Sequelize needs (advisory locks, prepared
#    statements in txns, LISTEN/NOTIFY); transaction pooling breaks those.
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
#
#    Migrations (sequelize-cli, config.cjs) and scripts/db-reset-remote.sh should
#    use the DIRECT connection, bypassing any pooler — DDL relies on session
#    state. Falls back to DATABASE_URL if unset.
# DATABASE_DIRECT_URL=postgresql://<user>:<password>@<direct-host>:5432/<database>
#
#    Managed Postgres serves TLS; point DB_SSL_CA_PATH at the provider CA bundle
#    to enable certificate + hostname verification. In production this is
#    REQUIRED (boot fails without it or the explicit DB_SSL_ALLOW_UNVERIFIED
#    opt-out above); in dev we skip verification.
# Surfaces the process in pg_stat_activity for triage.
DB_APP_NAME=social-commerce-api
# Max pool size per process. Keep (replicas * DB_POOL_MAX) below the server's
# max_connections (or the pooler's pool_size) or migrations/cron/sockets starve.
DB_POOL_MAX=10

# ── Auth / JWT ──────────────────────────────────────────────────────────────
# 32+ random bytes (`openssl rand -base64 48`). Rotating this invalidates every
# live access token. In PRODUCTION the app refuses to boot if this is under 32
# chars or looks like a placeholder — so this template value must be replaced.
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ── Commerce / pricing ──────────────────────────────────────────────────────
# Server-authoritative cart pricing. Defaults match the app's mock byte-for-byte
# (8% tax, flat $6.99 shipping over any non-empty cart). These are flat rates —
# real address-based sales tax is a separate integration (see DEFERRED-DECISIONS).
TAX_RATE=0.08
SHIPPING_FLAT_CENTS=699

# ── Feed ranking (For You) ──────────────────────────────────────────────────
# Heuristic ranker weights (rankingService). All optional — sensible defaults
# shown. score = engagement · recency · affinity.
# RANK_W_LIKE=1
# RANK_W_COMMENT=2
# RANK_W_SHARE=3
# RANK_W_SAVE=2
# RANK_HALF_LIFE_HOURS=24     # recency half-life
# RANK_FOLLOW_BOOST=1.5       # multiplier for followed authors
# RANK_SEEN_PENALTY=0.1       # multiplier for already-engaged videos
# RANK_WINDOW_DAYS=30         # candidate freshness window
# RANK_CANDIDATE_POOL=500     # max candidates scored per request

# ── Realtime / CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed browser origins (Socket.io + Express CORS). The native
# app sends no Origin header, so it is always allowed regardless of this list.
FRONTEND_URLS=http://localhost:3000
# Optional: enables the Socket.io Redis adapter + Redis-backed rate limiting for
# horizontal scaling. Omit for single-instance dev (in-memory fallback).
# REDIS_URL=redis://localhost:6379

# ── Media / Storage (S3) ─────────────────────────────────────────────────────
# Uploads (videos, avatars, product/chat images) go straight to an S3 bucket via
# presigned PUT URLs — the API server never proxies bytes. Objects must be
# publicly READABLE (playback URLs are persisted on rows and must not expire)
# but never publicly writable. Bucket policy + CORS + IAM: INTEGRATIONS.md.
# Empty S3_BUCKET → video publishing, avatar upload and chat images 503.
S3_BUCKET=
S3_REGION=us-east-1

# Credentials. OMIT BOTH when running with an instance/task role (EC2, ECS,
# EKS/IRSA) — the AWS SDK picks the role up automatically, which beats
# long-lived keys. Set them only for a static IAM user.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CDN domain in front of the bucket (CloudFront et al). Empty → the bucket's own
# S3 URL is used for playback.
S3_PUBLIC_BASE_URL=

# Non-AWS S3-compatible storage: Cloudflare R2, DigitalOcean Spaces, or the MinIO
# in docker-compose.yml for local dev (`npm run storage:up`):
#   S3_BUCKET=media
#   S3_ENDPOINT=http://127.0.0.1:9000
#   S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=iovibe-minio
#   AWS_SECRET_ACCESS_KEY=iovibe-minio-secret
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# Lifetime of a presigned upload URL, in seconds. Default 900 (15 min).
S3_UPLOAD_URL_TTL_SECONDS=900

# Upload ceilings, in megabytes, per `kind`. The size is checked here AND signed
# into the presigned URL (S3 rejects a PUT of any other size), so these are the
# real bound on what one account can park in the bucket — and on what the
# transcode worker has to pull onto its disk. Defaults:
#   video 150 — a 60s 1080p capture that skipped client compression is ~124 MB
#   image  25 — an uncompressed 12 MP PNG
#   avatar  8 — displayed at ~200 px; no reason for it to be post-sized
#   chat   15 — same content as image, but the highest-volume write path
UPLOAD_MAX_VIDEO_MB=150
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_AVATAR_MB=8
UPLOAD_MAX_CHAT_MB=15
# Longest publishable clip, milliseconds — enforced on POST /videos and on the
# video attachments of POST /posts. The app caps recording at 60s; 90s is that
# plus headroom for an overshooting recorder and gallery picks.
VIDEO_MAX_DURATION_MS=90000

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Physical goods + in-person tickets → Stripe is the compliant processor (IAP is
# prohibited for these by both stores).
# Where: Stripe Dashboard → Developers → API keys.
#   STRIPE_SECRET_KEY      → "Secret key"      (sk_test_… in dev)
#   STRIPE_PUBLISHABLE_KEY → "Publishable key" (pk_test_…) — returned to the app
#                             for its PaymentSheet; the app needs no Stripe env.
#   STRIPE_WEBHOOK_SECRET  → Developers → Webhooks → endpoint on
#                             POST /v1/webhooks/stripe (events: payment_intent.*)
#                             → "Signing secret" (whsec_…). Optional in dev: the
#                             confirm call verifies the PaymentIntent directly.
# Empty STRIPE_SECRET_KEY → every payment path returns 503.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
# Where: Firebase Console → Project settings → Service accounts → "Generate new
# private key", then base64 the whole JSON into ONE env value (no file on disk):
#   base64 -i service-account.json     (macOS)   →  paste the output here
#   base64 -w0 service-account.json    (Linux)
# The app also needs android/app/google-services.json at build time (INTEGRATIONS.md §5).
# Empty → push sending is a silent no-op (the app still runs).
FCM_SERVICE_ACCOUNT_BASE64=

# ── Email (password reset codes) ─────────────────────────────────────────────
# SMTP transport for the forgot/reset-password flow.
# Where: any SMTP provider — SendGrid, Resend, SES, Mailgun, Postmark (host,
# user and password come from their dashboard; SMTP_USER is often a literal
# such as "apikey").
# Empty SMTP_HOST → codes are generated but not delivered (the endpoints still
# succeed and never reveal account existence).
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; STARTTLS on 587 stays false.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Social Commerce <no-reply@yourapp.com>

# ── Geocoding (event venues → map pins) ──────────────────────────────────────
# Server-side geocoding of event addresses into lat/lng.
# Where: Google Cloud Console → APIs & Services → Credentials → API key, with
# the GEOCODING API enabled (the app's map key needs Maps SDK for Android; one
# key can serve both). Empty → created events store null coordinates and the app
# falls back to a deep link into the maps app.
GOOGLE_MAPS_API_KEY=

# ── WebRTC calls (STUN / TURN) ───────────────────────────────────────────────
# GET /v1/calls/ice-servers returns these to the app's RTCPeerConnection. STUN
# defaults to Google's public server and needs no account; a TURN relay is what
# makes calls connect across strict/symmetric NATs and carrier networks — two
# phones on mobile data need one or the call rings and never connects.
# Where: `deploy/provision.sh` installs and configures **coturn on your own
# server** and fills these in for you — no third-party account, no bill. See
# INTEGRATIONS.md § 7. TURN_URLS accepts a comma-separated list, e.g.
# turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
# The coturn `static-auth-secret`. Set this (not TURN_USERNAME/TURN_CREDENTIAL)
# whenever the relay runs with `use-auth-secret`: the server then mints a
# short-lived, per-user credential on every request instead of shipping one
# permanent password to every device.
TURN_STATIC_AUTH_SECRET=
# Lifetime of a minted credential, seconds. Default 43200 (12h).
TURN_CREDENTIAL_TTL_SECONDS=43200
# Only for a relay that has no shared secret to offer (some hosted providers).
# Ignored when TURN_STATIC_AUTH_SECRET is set.
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
